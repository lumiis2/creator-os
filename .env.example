# Shared
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/creatoros
DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@HOST:PORT/creatoros

# Auth (Auth.js)
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-32+char-random
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Redis (Upstash REST for web cache + token budget)
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Redis (BullMQ TCP)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

# AI provider
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_key
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# (optional) Groq
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
WEB_SEARCH_API_KEY=your_web_search_api_key
WEB_SEARCH_ENABLED=true
